{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashler.ai/schemas/code-product-v1.json",
  "title": "Ashler Code product manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productName",
    "defaultRepositoryBasename",
    "bundleIdentifiers",
    "urlSchemes",
    "dataDirectories",
    "domains",
    "updateFeed",
    "telemetry",
    "runtimeProfile"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "productName": { "type": "string", "minLength": 1 },
    "defaultRepositoryBasename": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$"
    },
    "bundleIdentifiers": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "urlSchemes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dataDirectories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "userData", "developmentUserData"],
      "properties": {
        "home": { "type": "string", "minLength": 1 },
        "userData": { "type": "string", "minLength": 1 },
        "developmentUserData": { "type": "string", "minLength": 1 }
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "updateFeed": { "type": "string", "minLength": 1 },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabledByDefault"],
      "properties": { "enabledByDefault": { "const": false } }
    },
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "profiles"],
      "properties": {
        "default": { "enum": ["local", "scaffold"] },
        "profiles": { "type": "object", "minProperties": 1 }
      }
    }
  }
}
