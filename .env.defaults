# Public Ashler distribution defaults. These values are safe to embed in client
# artifacts; user credentials and OAuth tokens remain in per-user storage.
T3CODE_SESSION_FABRIC_RELAY_URL=https://ashler-session-fabric-proof.cgoggins.workers.dev
T3CODE_SESSION_FABRIC_AUTH_MODE=required
T3CODE_SCAFFOLD_STAGING_URL=https://scaffold-staging.internal.ashler.com
T3CODE_SCAFFOLD_STAGING_AUTH_MODE=oauth
T3CODE_SCAFFOLD_PRODUCTION_URL=https://scaffold.internal.ashler.com
T3CODE_SCAFFOLD_PRODUCTION_AUTH_MODE=oauth
T3CODE_SCAFFOLD_DEFAULT_DEPLOYMENT=staging
